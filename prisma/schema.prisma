// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(uuid())
  username    String   @unique
  password    String
  role              String   @default("USER") // 'USER' | 'ADMIN' | 'SUPERADMIN'
  isActive          Boolean  @default(true)
  canResetPasswords Boolean  @default(false)
  karmaPoints       Int      @default(0)
  items             Item[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  loans        LoanRequest[] @relation("Loanee")
  requestedTickets Ticket[]  @relation("RequestedTickets")
  assignedTickets  Ticket[]  @relation("AssignedTickets")
}

model Item {
  id               String   @id @default(uuid())
  name             String
  description      String
  initialCondition String
  status           String   @default("AVAILABLE") // 'AVAILABLE' | 'LOANED' | 'DISPUTED'
  ownerId          String
  owner            User     @relation(fields: [ownerId], references: [id])
  images           String   // Stored as JSON string
  isPublic         Boolean  @default(true)
  personalNotes    String   @default("")
  location         String   @default("Unspecified")
  tags             String   // Stored as JSON string
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  loans            LoanRequest[]
}

model LoanRequest {
  id                  String   @id @default(uuid())
  itemId              String
  item                Item     @relation(fields: [itemId], references: [id])
  
  loaneeId            String?
  loanee              User?    @relation("Loanee", fields: [loaneeId], references: [id])
  externalLoaneeName  String?
  
  loaneeObservation   String   @default("")
  ownerStatusUpdate   String   @default("")

  receivedCondition       String   @default("")
  receivedConditionStatus String   @default("PENDING_OWNER_REVIEW") // 'PENDING_OWNER_REVIEW' | 'ACCEPTED' | 'DISPUTED'
  
  returnCondition         String   @default("")
  returnConditionStatus   String   @default("PENDING") // 'PENDING' | 'ACCEPTED' | 'DISPUTED'

  arbitrationRequested Boolean @default(false)
  
  status              String   @default("PENDING") // 'PENDING' | 'APPROVED' | 'ACTIVE' | 'RETURN_PENDING' | 'COMPLETED'
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Ticket {
  id              String   @id @default(uuid())
  title           String
  description     String
  status          String   @default("OPEN") // 'OPEN' | 'IN_PROGRESS' | 'RESOLVED' | 'CLOSED'
  priority        String   @default("MEDIUM") // 'LOW' | 'MEDIUM' | 'HIGH' | 'CRITICAL'
  tag             String   // 'GEAR_DISPUTE' | 'PASSWORD_RESET' | 'HELP_REQUEST' | 'OTHER'
  requesterId     String?
  requester       User?    @relation("RequestedTickets", fields: [requesterId], references: [id])
  assignedToId    String?
  assignedTo      User?    @relation("AssignedTickets", fields: [assignedToId], references: [id])
  relatedEntityId String?  // Stores LoanRequest ID if it's a gear dispute
  resolutionNotes String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
